# Server Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Database Configuration (PostgreSQL / SQLite compatibility)
DATABASE_URL="file:./dev.db"
# For PostgreSQL in Docker or Production:
# DATABASE_URL="postgresql://alwaheed_user:StrongPassword2026!@localhost:5432/alwaheed_db?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_SECRET="super-secret-jwt-key-replace-in-production-al-waheed-2026"
JWT_EXPIRES_IN="7d"

# Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_PATH="./uploads"

# Optional Cloud Storage (S3 / Cloudinary)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Verified Enterprise Contact Defaults (Can also be managed from Admin Settings)
NEXT_PUBLIC_STORE_NAME_AR="مؤسسة الوحيد للزخرفة المعمارية ونحت والمقاولات العامة"
